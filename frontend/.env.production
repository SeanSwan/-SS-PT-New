# SwanStudios Frontend Production Environment
# =============================================
# Production-only environment variables

# API Configuration (Production)
VITE_API_URL=https://sswanstudios.com
VITE_API_BASE_URL=https://sswanstudios.com
VITE_BACKEND_URL=https://sswanstudios.com
VITE_WS_URL=wss://sswanstudios.com/schedule-updates
VITE_NODE_ENV=production

# App Configuration
VITE_APP_NAME=SwanStudios
VITE_APP_VERSION=1.0.0

# Stripe Configuration (Production - MATCHING BACKEND KEYS)
VITE_STRIPE_PUBLISHABLE_KEY=__SET_IN_RENDER__

# Feature Flags (Production)
VITE_ENABLE_MCP_SERVICES=false
VITE_ENABLE_STRIPE=true
VITE_ENABLE_NOTIFICATIONS=true

# Production Settings
VITE_DEBUG_MODE=false
