// Scoped typecheck for the mission QA harness (frontend/e2e/mission).
//
// WHY: `tsc --noEmit` over the whole frontend exhausts the V8 heap on this repo
// (OOM at both the default limit and --max-old-space-size=8192), so there is no
// way to prove a change to the harness typechecks using the project config.
// Playwright transpiles specs with esbuild and never typechecks them, so without
// this file the mission directory has NO type gate at all.
//
// Usage: npx tsc -p tsconfig.mission-check.json
{
  "compilerOptions": {
    // ES2022, not the project's ES2020: this directory runs under Node 22 and
    // Chromium (never shipped to a browser), and already uses ES2022 built-ins
    // such as Array.prototype.at. Declaring ES2020 here reported a false error
    // against working code.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "types": ["node"]
  },
  "include": ["e2e/**/*.ts"]
}
