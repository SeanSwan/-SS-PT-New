{
  "name": "swanstudios-minimal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "node --max-old-space-size=12288 ./node_modules/typescript/bin/tsc --noEmit --pretty false",
    "test": "vitest",
    "test:run": "node ./scripts/run-vitest-shards.mjs",
    "test:coach-plaud-flow": "vitest run src/components/DashBoard/Pages/coach-assistant src/components/PlaudClipMerge/PlaudMergeReviewFocus.test.tsx src/components/PlaudClipMerge/PlaudMergeWorkspaceOutcome.test.tsx src/pages/dashboard/PlaudIntelligenceWorkspacePage.test.tsx --reporter verbose --testTimeout 10000",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "node ../scripts/qa/playwright-smoke.mjs",
    "test:e2e:smoke:prod": "node ../scripts/qa/playwright-smoke.mjs --prod",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:api": "playwright test --project=\"API Tests\" --workers=1",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --max-warnings 9999",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx,.js,.jsx --max-warnings 0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@radix-ui/react-toast": "^1.2.15",
    "@reduxjs/toolkit": "^2.0.1",
    "@stripe/stripe-js": "^8.9.0",
    "@tanstack/react-query": "^5.15.5",
    "@types/react-simple-maps": "^3.0.6",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.5",
    "hash-wasm": "^4.11.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.300.0",
    "moment": "^2.29.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.20.1",
    "react-simple-maps": "^3.0.0",
    "react-toastify": "^9.1.3",
    "react-window": "^2.2.7",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "signature_pad": "^5.1.3",
    "socket.io-client": "^4.7.5",
    "styled-components": "^6.1.6",
    "tailwind-merge": "^3.5.0",
    "three": "^0.169.0",
    "uuid": "^13.0.0",
    "victory": "^37.3.6",
    "vite": "^6.4.3",
    "@swan/forge": "file:../packages/swan-forge"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.169.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "colors": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-styled-components-a11y": "^2.2.1",
    "jsdom": "^27.4.0",
    "lighthouse": "^12.6.1",
    "msw": "^2.12.7",
    "puppeteer": "^24.35.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "react-simple-maps": {
      "d3-zoom": "3.0.0"
    },
    "d3-transition": "3.0.1",
    "d3-interpolate": "3.0.1",
    "d3-color": "3.1.0"
  }
}
