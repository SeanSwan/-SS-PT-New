# SwanStudios Backend Environment - LOCAL DEVELOPMENT ONLY
# ======================================================
# ⚠️ THIS FILE CONTAINS SECRETS - NEVER COMMIT TO GIT
# ⚠️ USE RENDER DASHBOARD FOR PRODUCTION SECRETS

# Application Settings
NODE_ENV=development
PORT=10000
BACKEND_PORT=10000

# CORS Configuration
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Database Configuration (Local Development)
# For production, set these in Render Dashboard
PG_HOST=localhost
PG_PORT=5432
PG_DB=swanstudios
PG_USER=swanadmin
PG_PASSWORD=your_local_postgres_password

# Production Database (from Render)
DATABASE_URL=your_render_postgres_url_here

# Authentication & Security
JWT_SECRET=your_local_jwt_secret_here
JWT_REFRESH_SECRET=your_local_jwt_refresh_secret_here
JWT_EXPIRES_IN=3h
ACCESS_TOKEN_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# Authentication method rollout (all providers fail closed until flag + credentials exist)
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_CALLBACK_BASE_URL=http://localhost:10000
AUTH_MAGIC_LINK_ENABLED=false
MAGIC_LINK_SECRET=replace_with_a_distinct_high_entropy_secret
AUTH_GOOGLE_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
AUTH_APPLE_ENABLED=false
APPLE_AUTH_CLIENT_ID=
APPLE_AUTH_CLIENT_SECRET=
AUTH_FACEBOOK_ENABLED=false
FACEBOOK_AUTH_CLIENT_ID=
FACEBOOK_AUTH_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=
AUTH_TIKTOK_ENABLED=false
TIKTOK_AUTH_CLIENT_KEY=
TIKTOK_AUTH_CLIENT_SECRET=

# Admin Configuration
ADMIN_ACCESS_CODE=your_admin_access_code_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=your_admin_email_here
SUPER_ADMIN_EMAILS=

# Payment defaults
DEFAULT_ZELLE_RECIPIENT=
DEFAULT_VENMO_HANDLE=
DEFAULT_CHECK_PAYEE_NAME=SwanStudios

# Email Configuration (Development)
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=your_from_email_here

# Stripe Configuration (Development)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Twilio Configuration (Development)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_here

# Legacy MCP Configuration (retired; keep disabled unless deliberately restoring the old server stack)
ENABLE_MCP_ROUTES=false
ENABLE_MCP_SERVICES=false
ENABLE_MCP_HEALTH_CHECKS=false
ENABLE_MCP_HEALTH_ALERTS=false

# Backend API URL
BACKEND_API_URL=http://localhost:10000/api

# AI Provider Router (Phase 3+)
AI_PROVIDER_ORDER=openai,anthropic,gemini,venice
AI_GLOBAL_TIMEOUT_MS=25000
AI_PROVIDER_TIMEOUT_MS=10000

# Primary AI Config (OpenRouter recommended — works with any model)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-sonnet-4-6

# Direct provider API keys (legacy / fallback — only needed for direct connections)
# OPENAI_API_KEY=          # Falls back if AI_API_KEY is empty
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# VENICE_API_KEY=

# Optional per-provider model overrides (used by direct adapters)
# AI_OPENAI_MODEL=gpt-4
AI_ANTHROPIC_MODEL=claude-sonnet-4-6
AI_GEMINI_MODEL=gemini-2.0-flash
AI_VENICE_MODEL=llama-3.3-70b
AI_VENICE_BASE_URL=https://api.venice.ai/api/v1

# Redis Configuration (Disabled by default)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
