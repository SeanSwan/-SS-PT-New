# ============================================
# Refactor Sprint 2026-02-13 — Bloat prevention
# ============================================

# Root-level Playwright/QA screenshots (use docs/qa/baseline/ instead)
/*.png
/*.jpg
/*.jpeg

# Root-level Jupyter notebooks (scoped to root to avoid ignoring intentional notebooks in subdirs)
/*.ipynb

# Windows null device artifacts
/nul

# Executable installers in frontend assets (scoped to avoid ignoring intentional binaries elsewhere)
frontend/src/assets/*.exe

# Large media files — raw photos, bulk photo folders
frontend/src/assets/*.ARW
frontend/src/assets/Super-Nova-3-8-26/

# Temp login/test artifacts
_tmp_login.json

# Untracked MCP/AI server directories
/backend/unified-ai-server/

# QA screenshots & Playwright test artifacts
qa-screenshots/
qa-screenshots-*/
playwright-qa-full/
playwright-qa-screenshots/

# Root-level generated dashboard/browser snapshots
/admin-*.yml
/client-*.yml
/trainer-*.yml
/user-dash-*.yml
/tsc-errors.txt

# ============================================
# CREDENTIAL PROTECTION — added 2026-04-19 after settings.local.json leak
# ============================================

# Claude Code local settings — contains allow-list that can leak commands with credentials
.claude/settings.local.json
.claude/**/settings.local.json
.claude/**/*.local.json
.claude/projects/
.claude/memory/
.claude/todos/

# Comprehensive env file coverage (belt-and-suspenders on top of existing .env rules)
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.template
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.template

# Additional secret-bearing files
secrets.json
credentials.json
*.secrets
*.credentials.json
PRODUCTION-SECRETS.env
*-secrets.env
*-SECRETS.env

# SSH private keys
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
*.ppk
!*.ppk.example

# SSL/TLS certificates and keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.pkcs12
*.jks
!**/public*.pem
!**/public*.key
!**/public*.crt

# GPG / PGP
*.gpg
*.asc
secring.gpg
secring.*

# Cloud provider credentials
.aws/
.azure/
.gcloud/
service-account*.json
gcloud-keys.json
firebase-service-account*.json
firebase-adminsdk*.json
.firebase/

# NPM auth tokens
.npmrc
!.npmrc.example

# MCP / AI tool configs (may contain API keys)
mcp.json
.mcp.json
claude_desktop_config.json
.claude/config.json

# Token / session files
*.token
*token.txt
auth-token.*
session.json
.auth/
.session/

# Terraform state (contains plaintext secrets)
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars
*.auto.tfvars

# Kubernetes secrets
*secret*.yaml
*secret*.yml
kubeconfig
!kubeconfig.example

# Ansible vault
*.vault
vault_password
vault-password.*

# Docker secrets
docker-compose.override.yml
.docker/config.json

# JWT / API key dumps from debugging
*.jwt
*-token.json
admin-token.json
test-admin-token.*
bearer-token.*

# ============================================
# AI Workflow runtime + archives (added 2026-04-19 per v3 Patch 3)
# ============================================
# Shape changed 2026-04-22: was `.ai-workflow/` (opaque-dir), now `.ai-workflow/*`
# so we can un-ignore specific subdirs like continuity/ (Phase B needs README tracked).
# git cannot re-include paths inside an opaque-ignored parent, so the parent must be `/*` style.
.ai-workflow/*
!.ai-workflow/continuity/
!.ai-workflow/coordination/
# Gate shadow-mode config (2026-08-26) MUST be tracked. It is shared enforcement state:
# if it lives in one working tree only, every other checkout keeps blocking while this one
# does not — the split-brain drift-check 8 exists to catch, and which is exactly what this
# commit is fixing (enforcement shipped to main, relief left on a branch).
!.ai-workflow/gate-mode.json

# Gate telemetry — per-machine operational data, never shared state.
.ai-workflow/gate-telemetry.jsonl
!.ai-workflow/hermes-inbox/
# swan-gate (SWA-32): task gates stay local; shared gate helpers are tracked
!.ai-workflow/gates/
.ai-workflow/gates/*
!.ai-workflow/gates/_lib/
.ai-workflow/audit/**
# Phase B continuity bridge (2026-04-22): README is tracked, runtime files gitignored
.ai-workflow/continuity/*
!.ai-workflow/continuity/README.md
# Live pair-coding coordination ledger (2026-06-13): README tracked, live lane/queue
# files gitignored — they are same-machine real-time scratch, not git history, so they
# carry zero commit churn and can never cause a merge conflict between Claude & Codex.
.ai-workflow/coordination/*
!.ai-workflow/coordination/README.md
# Generated, manual-only broadcast so off-machine agents can see who holds what.
# The LIVE lane files stay ignored: tracking those would cause the merge conflicts
# the ledger exists to prevent. This one changes only when someone runs `lane snapshot`.
!.ai-workflow/coordination/SNAPSHOT.md
# Hermes Inbox (2026-07-06, Rule 69): the WHOLE subtree is TRACKED — unlike continuity/
# coordination (local-only runtime scratch), the inbox IS the transport: memos must travel
# via git to reach Hermes on the Pi. Committed + LLM-read, so IDs/roles only + secret-scanned.
!.ai-workflow/hermes-inbox/**
scripts/continuity-config.local.json
SOUL.archive/
SOUL.archive/**

# AI-generated scratch files
.claude/projects/
.claude/memory/
.claude/todos/

# Understand-Anything generated graph
# Keep .understand-anything/knowledge-graph.json trackable; ignore local scratch.
**/.understand-anything/intermediate/
**/.understand-anything/tmp/
**/.understand-anything/diff-overlay.json

# Allowlist for SOUL.md files (the working idea archive is TRACKED per project)
!SOUL.md
!**/SOUL.md

# Playwright MCP session recordings (may capture typed-in credentials)
.playwright-mcp/

# Swan World Engine factory outputs (local, ignored proofs only)
experiments/world-factory/
scripts/qa/.qa-schema-manifest.json

# Render agent credential — a token that can lease jobs and report completions.
.swan-agent.env
**/.swan-agent.env

# Rendered video auditions — large binaries, regenerable from the committed prompts
variants/
*.mp4

# Generated DB schema snapshot — `node scripts/schema-snapshot.mjs` rebuilds it from
# backend/models/*.mjs, so it is derived state, not source. It churns on every model
# change and would conflict constantly across the parallel agent lanes (Rule 39).
# NOTE: its consumer, the DB blast-radius gate, is not on main yet — it lives only on
# wip/comms-notifications-2026-07-05. Whoever lands that gate should revisit whether the
# snapshot needs to be committed so the gate works on a fresh clone.
backend/schema-snapshot.json

# Paid-AI spend ledger — machine-local running totals, not repo history
.ai-workflow/spend/

# Bypass ledger — records escape-hatch use (SWA-200). Machine-local, IDs and redacted
# fragments only, never prompt content. Same posture as the spend ledger.
.ai-workflow/bypass/
