#!/usr/bin/env bash
# pre-commit hook — Swan Studios
# Runs scripts/scan-secrets.sh on staged files.
# Installed via: git config core.hooksPath .githooks
#
# To bypass in emergencies (DO NOT MAKE A HABIT):
#   git commit --no-verify
# Per CLAUDE.md Rule 44, secret scanning is MANDATORY.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$REPO_ROOT/scripts/scan-secrets.sh"

if [[ ! -x "$SCANNER" ]]; then
  echo "⚠️  scripts/scan-secrets.sh not executable. Run: chmod +x scripts/scan-secrets.sh" >&2
  exit 1
fi

echo "[pre-commit] Running secret scan on staged files..."
if ! "$SCANNER" --staged; then
  cat >&2 <<'EOF'

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
COMMIT BLOCKED: secret-pattern detected in staged changes.

Next steps:
1. Remove the secret from the file (use env vars / getpass / read -s instead)
2. If this is a KNOWN-ROTATED historical fingerprint needed for incident documentation,
   add an allowlist entry to .secretignore:
       docs/your/file.md::rotated-render-pg-2026-04

Per CLAUDE.md Rule 44: secret scanning covers writes, not only shell commands.
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
  exit 1
fi

echo "[pre-commit] Secret scan: CLEAN"

# ── Lane-staged guard ────────────────────────────────────────────────────────
# Refuses a commit carrying files this session never claimed.
#
# WHY: Claude and Codex share ONE git index. `git add` by A followed by `git commit`
# by B puts A's files in B's commit. Observed three times in 24 hours, including once
# by the agent that had documented it the day before. Lane discipline cannot prevent
# it — it is a property of the shared index, not of protocol compliance. Five of six
# hostile panel seats ranked it P0, above every other open item.
#
# OPT-IN BY CLAIMING, deliberately. No lane published -> the guard allows and says so.
# Forcing lane discipline onto every commit is how this becomes the gate everyone
# disables, and a disabled gate protects nothing. Claiming opts you in, and claiming
# is already the house rule (Rule 67 R2).
#
# Runs AFTER the secret scan: a leaked credential outranks a lane violation.
#
# FAIL-OPEN ON ITS OWN BUGS, LOUDLY. Only the guard's deliberate exit 2 blocks. Any
# other non-zero — node absent, a crash, a bad parse — allows the commit and prints
# why. A pre-commit hook that bricks committing gets deleted within a day.
#
# Escape hatches, both greppable after the fact:
#   node scripts/lane-staged-guard.mjs --allow-foreign   (deliberate, per-commit)
#   git commit --no-verify                               (skips this and the scanner)
LANE_GUARD="$REPO_ROOT/scripts/lane-staged-guard.mjs"
if [[ -f "$LANE_GUARD" ]] && command -v node >/dev/null 2>&1; then
  set +e
  node "$LANE_GUARD"
  LANE_RC=$?
  set -e
  if [[ $LANE_RC -eq 2 ]]; then
    echo "[pre-commit] COMMIT BLOCKED by lane-staged guard (see above)." >&2
    exit 1
  elif [[ $LANE_RC -ne 0 ]]; then
    echo "[pre-commit] lane-staged guard errored (rc=$LANE_RC) — allowing commit (fail-open)." >&2
  fi
fi

# -- Windows script ASCII gate -----------------------------------------------
# Four Windows scripts have shipped broken on smart punctuation (an em dash in a .cmd FILENAME,
# then three .ps1 files whose quotes PowerShell could not parse). The last one was a SECURITY fix
# that silently did not run. The file never parses, so nothing executes and the error points at a
# quote several characters from the real culprit -- exactly the class a human review misses.
# BLOCKS on violations; fail-open on its own bugs, like the other guards here.
ASCII_GATE="$REPO_ROOT/scripts/hooks/windows-script-ascii-gate.mjs"
if [[ -f "$ASCII_GATE" ]]; then
  set +e
  node "$ASCII_GATE" --staged
  ASCII_RC=$?
  set -e
  if [[ $ASCII_RC -eq 1 ]]; then
    echo "[pre-commit] COMMIT BLOCKED by windows-script-ascii gate (see above)." >&2
    exit 1
  elif [[ $ASCII_RC -ne 0 ]]; then
    echo "[pre-commit] windows-script-ascii gate errored (rc=$ASCII_RC) -- allowing commit (fail-open)." >&2
  fi
fi

# -- Egress chokepoint guard (SWA-237) ----------------------------------------
# A script that reaches an external MODEL host must go through fetchForEgress, or
# it skips the identity/secret redactor, the subscription-seat guard, and the
# training-tier gate. Raised by Muse Spark reviewing its own gate: fetchForEgress
# is described as "the transport" but is really a function you must remember to
# call, so every control layered on it is opt-in.
#
# RATCHET: staged files only. Five pre-existing violations in scripts/ block
# nothing until someone edits them (`--all` reports the backlog). Scoped to
# scripts/ deliberately — backend AI paths answer to Rule 8 / aiPrivacyService,
# a different control; see SWA-238.
#
# This is a LINT, not the boundary. The boundary is SWA-237's other half: binding
# the API key so a caller cannot authenticate a request it assembled itself.
# BLOCKS on violations; fail-open on its own bugs, like the guards above.
EGRESS_GUARD="$REPO_ROOT/scripts/hooks/egress-chokepoint-guard.mjs"
if [[ -f "$EGRESS_GUARD" ]] && command -v node >/dev/null 2>&1; then
  set +e
  node "$EGRESS_GUARD" --staged
  EGRESS_RC=$?
  set -e
  if [[ $EGRESS_RC -eq 1 ]]; then
    echo "[pre-commit] COMMIT BLOCKED by egress-chokepoint guard (see above)." >&2
    exit 1
  elif [[ $EGRESS_RC -ne 0 ]]; then
    echo "[pre-commit] egress-chokepoint guard errored (rc=$EGRESS_RC) -- allowing commit (fail-open)." >&2
  fi
fi

# -- AI/harness egress policy ratchet ----------------------------------------
# Catches new repository/workspace capture instructions, raw external transport
# in AI scripts, and protected-root reads. This is deliberately separate from
# egress-chokepoint: that guard focuses on known model hosts, while this policy
# covers harness configuration and the broader repository snapshot incident.
# Exit 2 is an audit failure and blocks; a security audit must not turn an
# unreadable index into a green result.
AI_EGRESS_AUDIT="$REPO_ROOT/scripts/qa/ai-egress-audit.mjs"
if [[ -f "$AI_EGRESS_AUDIT" ]] && command -v node >/dev/null 2>&1; then
  # Resolve the index in Bash, where this hook already runs, then pass the
  # exact newline-delimited paths to Node. This keeps the audit independent of
  # nested child-process restrictions in some managed Windows harnesses.
  AI_EGRESS_STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)" \
    node "$AI_EGRESS_AUDIT" --staged
  AI_EGRESS_RC=$?
  if [[ $AI_EGRESS_RC -ne 0 ]]; then
    echo "[pre-commit] COMMIT BLOCKED by ai-egress policy (see above)." >&2
    exit 1
  fi
fi

# NOTE: the rulebook-review guard lives in .githooks/commit-msg, NOT here. It needs the
# commit MESSAGE, and during pre-commit the message is not written yet (with -m, git
# writes COMMIT_EDITMSG after pre-commit) — a pre-commit read sees the PREVIOUS commit's
# message. A guard on stale input is worse than none.

exit 0
