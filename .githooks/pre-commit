#!/usr/bin/env bash
# pre-commit hook — Swan Studios
# Runs scripts/scan-secrets.sh on staged files.
# Installed via: git config core.hooksPath .githooks
#
# To bypass in emergencies (DO NOT MAKE A HABIT):
#   git commit --no-verify
# Per CLAUDE.md Rule 44, secret scanning is MANDATORY.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$REPO_ROOT/scripts/scan-secrets.sh"

if [[ ! -x "$SCANNER" ]]; then
  echo "⚠️  scripts/scan-secrets.sh not executable. Run: chmod +x scripts/scan-secrets.sh" >&2
  exit 1
fi

echo "[pre-commit] Running secret scan on staged files..."
if ! "$SCANNER" --staged; then
  cat >&2 <<'EOF'

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
COMMIT BLOCKED: secret-pattern detected in staged changes.

Next steps:
1. Remove the secret from the file (use env vars / getpass / read -s instead)
2. If this is a KNOWN-ROTATED historical fingerprint needed for incident documentation,
   add an allowlist entry to .secretignore:
       docs/your/file.md::rotated-render-pg-2026-04

Per CLAUDE.md Rule 44: secret scanning covers writes, not only shell commands.
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF
  exit 1
fi

echo "[pre-commit] Secret scan: CLEAN"

# Frontend design-rule guards (SWA-32 Slice 0, Rule 73 twice=codify):
# G1 no-MUI · G2 no-recharts · G3 retired Galaxy palette · G4 hardcoded hex.
# Staged frontend/src files only; existing violations tracked separately (Rule 34).
echo "[pre-commit] Running frontend guards on staged files..."
if ! node "$REPO_ROOT/scripts/hooks/frontend-guards.mjs" --staged; then
  echo "COMMIT BLOCKED: frontend design-rule violation (see FAIL lines above)." >&2
  echo "These rules are mechanically enforced — fix the line, do not bypass. (CLAUDE.md rules 1/6/10)" >&2
  exit 1
fi

# Constitution integrity (added 2026-08-14 after commit 10a3e7fa1 silently
# reverted 9 MANDATORY rules from CLAUDE.md while shipping two correct edits).
# Blocks: rule deletion, silent renumbering, body reversion, and mirror drift.
# Only runs when a constitution file is staged; skips otherwise.
#
# Absence is announced, never silent. `core.hooksPath` is relative (`.githooks`),
# so every worktree runs ITS OWN committed hooks — but a worktree checked out
# before this guard existed has the hook file without the script. Failing there
# would break commits on old branches for no safety gain; failing SILENTLY would
# reproduce the exact defect this guard exists to catch. So: say so, loudly.
CONSTITUTION_GUARD="$REPO_ROOT/scripts/hooks/constitution-guard.mjs"
if [[ -f "$CONSTITUTION_GUARD" ]]; then
  echo "[pre-commit] Running constitution guard..."
  if ! node "$CONSTITUTION_GUARD"; then
    exit 1
  fi
elif git diff --cached --name-only | grep -qE '^(CLAUDE\.md|AGENTS\.md)$'; then
  # Editing the constitution in a checkout too old to carry its guard is the
  # highest-risk case there is. Refuse rather than wave it through.
  echo "COMMIT BLOCKED: you are editing a constitution file, but this checkout" >&2
  echo "  has no scripts/hooks/constitution-guard.mjs (it predates 2026-08-14)." >&2
  echo "  Rebase/merge onto current main before editing CLAUDE.md or AGENTS.md," >&2
  echo "  or the same silent rule-deletion that caused 10a3e7fa1 can recur here." >&2
  exit 1
else
  echo "[pre-commit] constitution guard: SCRIPT ABSENT (pre-2026-08-14 checkout) — skipped; no constitution file staged"
fi

# Skill-advertising parity (added 2026-08-14, Kimi finding D7). The routing table
# in CLAUDE.md IS the router: a skill absent from it never fires. That table had
# drifted 43% (23 advertised vs 42 installed) while entrypoint validation passed
# the whole time, because existence is not advertisement.
# Constitution reference resolution (added 2026-08-15, Kimi round-1 question 6).
# Four defects in the 2026-08-14 repair were identical in BOTH constitutions, so no
# diff or mirror-parity check could ever surface them. The mechanical half of
# "read for contradiction" is: resolve the document's verifiable assertions against
# ground truth. Cited paths are the cheapest such assertion — first run found five
# documents that NEVER existed in git, two of them marked MANDATORY.
CONSTITUTION_REFS="$REPO_ROOT/scripts/hooks/constitution-references.mjs"
if git diff --cached --name-only | grep -qE '^(CLAUDE\.md|AGENTS\.md)$'; then
  if [[ -f "$CONSTITUTION_REFS" ]]; then
    echo "[pre-commit] Resolving constitution references..."
    if ! node "$CONSTITUTION_REFS"; then
      exit 1
    fi
  else
    echo "[pre-commit] constitution-refs: SCRIPT ABSENT in this checkout — skipped (announced, not silent)"
  fi
fi

# Token registry — CLAUDE.md Rule 6, the half G4 cannot see.
# G4 (frontend-guards) proves the SHAPE is right: a raw hex must sit in the fallback
# position of var(--token, #hex). Nothing proved the TOKEN EXISTS. So `var(--bg-elevatd,
# #141419)` — one transposed letter — passes G4, renders its fallback forever, and can
# never respond to theming. Nothing catches it, because it looks correct.
#
# Gated with --added-only, NOT --strict. Measured 2026-08-21: the standing backlog is 831
# undefined token uses across 1,735 sites plus 610 drift findings, and --strict would block
# a sampled 32% of frontend files on debt their author never wrote. A gate that fails on
# inherited debt gets switched off (Rule 34). --added-only fails ONLY on undefined tokens
# introduced by lines this commit ADDS; the backlog is reported and never blocks.
TOKEN_CHECK="$REPO_ROOT/scripts/hooks/token-registry-check.mjs"
# Read into an ARRAY, not a string. A string would need to be left unquoted to pass
# multiple paths as separate argv entries, and word-splitting then breaks any path
# containing a space into fragments. The checker silently drops --file paths that do
# not exist, so such a file would be SKIPPED while its siblings passed — a gate that
# reports green on work it never looked at. frontend/src already contains one path with
# a space today.
mapfile -t STAGED_FE < <(git diff --cached --name-only --diff-filter=ACM -- 'frontend/src/*.ts' 'frontend/src/*.tsx' 'frontend/src/*.css')
if [[ ${#STAGED_FE[@]} -gt 0 ]]; then
  if [[ -f "$TOKEN_CHECK" ]]; then
    # The checker reads the WORKING TREE, while --added-only reads added lines from the
    # INDEX. If a staged file differs between the two, those line numbers describe a
    # different tree than the one being committed, and a pass here would vouch for the
    # wrong blob. Refuse to certify rather than issue a verdict about the wrong tree.
    # (Same reasoning as the Design Brain check below.)
    TOKEN_UNSTAGED="$(git diff --name-only -- "${STAGED_FE[@]}")"
    if [[ -n "$TOKEN_UNSTAGED" ]]; then
      echo "COMMIT BLOCKED: staged frontend files differ between the working tree and the index." >&2
      echo "  token-registry-check reads the working tree, so it CANNOT vouch for what you are committing." >&2
      echo "  Stage or stash these, then commit:" >&2
      echo "$TOKEN_UNSTAGED" | sed 's/^/    /' >&2
      exit 1
    fi
    echo "[pre-commit] Running token registry check on staged frontend files (added lines only)..."
    if ! node "$TOKEN_CHECK" --added-only --file "${STAGED_FE[@]}"; then
      echo "COMMIT BLOCKED: a line you are ADDING uses a CSS custom property that is never defined." >&2
      echo "  This is Rule 6's other half — G4 checks the shape, this checks the token exists." >&2
      exit 1
    fi
  else
    echo "[pre-commit] token registry check: SCRIPT ABSENT in this checkout — skipped (announced, not silent)"
  fi
fi

SKILL_REGISTRY="$REPO_ROOT/scripts/ai-workflow/validate-skill-registry.mjs"
if git diff --cached --name-only | grep -qE '^(CLAUDE\.md|AGENTS\.md|\.claude/skills/|\.agents/skills/)'; then
  if [[ -f "$SKILL_REGISTRY" ]]; then
    echo "[pre-commit] Running skill-advertising parity check..."
    if ! node "$SKILL_REGISTRY" --check; then
      echo "COMMIT BLOCKED: skill registry / advertising parity (see FAIL lines above)." >&2
      exit 1
    fi
  else
    echo "[pre-commit] skill-advertising check: SCRIPT ABSENT in this checkout — skipped (announced, not silent)"
  fi
fi

BRAIN_LINKS="$REPO_ROOT/scripts/design-brain/check-brain-links.mjs"
if git diff --cached --name-only | grep -qE '^(docs/ai-workflow/design-brain/|scripts/design-brain/)'; then
  if [[ -f "$BRAIN_LINKS" ]]; then
    # The checker reads the WORKING TREE, not the staged index. If any brain file differs
    # between them, a pass here says nothing about the blob being committed: stage a broken
    # file, fix it on disk without staging, and the gate waves the broken blob through.
    # Refuse to certify in that state rather than issue a verdict about the wrong tree.
    BRAIN_UNSTAGED="$(git diff --name-only -- docs/ai-workflow/design-brain/ scripts/design-brain/)"
    if [[ -n "$BRAIN_UNSTAGED" ]]; then
      echo "COMMIT BLOCKED: Design Brain files differ between the working tree and the index." >&2
      echo "  The structural check reads the working tree, so it CANNOT vouch for what you are committing." >&2
      echo "  Stage or stash these, then commit:" >&2
      echo "$BRAIN_UNSTAGED" | sed 's/^/    /' >&2
      exit 1
    fi
    echo "[pre-commit] Running Design Brain structural check (dangling refs / index law)..."
    if ! node "$BRAIN_LINKS"; then
      echo "COMMIT BLOCKED: Design Brain structural defect (see the D-class findings above)." >&2
      echo "  A dangling ref makes an agent silently SKIP the doctrine it cannot find." >&2
      exit 1
    fi
  else
    echo "[pre-commit] brain-links check: SCRIPT ABSENT in this checkout — skipped (announced, not silent)"
  fi
fi

# Paid-seat coverage contract (SWA-218). Every script that reads a payment
# credential must be matched by the spend gate, or be on an allowlist WITH a
# written reason. No third option.
#
# WHY IT IS A COMMIT GATE AND NOT JUST A TEST. A contract nobody runs is the same
# disease as a gate that never fires — the defect this whole workstream exists to
# fix. It found seven unmetered scripts on its first run, including the paid AI
# Village, after the hand-curated roster had drifted in BOTH directions for weeks
# with nothing to notice. Drift lands in a commit; this is where to catch it.
# Measured at ~0.25s, so it can never become the check people learn to bypass.
#
# SCOPED to staged changes under scripts/, because that is exactly what the
# contract walks. A frontend-only commit gets silence.
if git diff --cached --name-only | grep -qE '^scripts/'; then
  COVERAGE="$REPO_ROOT/scripts/hooks/spend-coverage.test.mjs"
  if [[ -f "$COVERAGE" ]]; then
    echo "[pre-commit] Running paid-seat coverage contract..."
    if ! node "$COVERAGE" > /dev/null 2>&1; then
      node "$COVERAGE" 2>&1 | sed -n '/read a payment credential/,/Do not delete this test/p' >&2
      echo "COMMIT BLOCKED: a script can spend money with no cap, no token and no record." >&2
      echo "  Classify it in scripts/lib/paid-seats.mjs. Details above." >&2
      exit 1
    fi

    # The contract walks the WORKING TREE, not the staged index — the same caveat
    # the token-registry and Design Brain checks above handle by refusing outright.
    # This one only WARNS, deliberately, and the difference is the cost of being wrong:
    #   - a real FAILURE is real either way, so it blocks regardless (above);
    #   - a false PASS lets one unmetered script through for a single commit, and
    #     the contract catches it on the next clean run.
    # Hard-refusing every commit that touches scripts/ while anything under it is
    # unstaged would block ordinary in-progress work for a modest gain — and a gate
    # that cries wolf is the one people learn to wave through, which is the failure
    # mode this workstream keeps running into. Revisit deliberately if a false pass
    # ever actually costs something.
    COVERAGE_UNSTAGED="$(git diff --name-only -- scripts/)"
    if [[ -n "$COVERAGE_UNSTAGED" ]]; then
      echo "[pre-commit] coverage contract: PASS on the working tree — NOT a verdict on the index." >&2
      echo "  Unstaged under scripts/, so the commit itself is unverified by this check:" >&2
      echo "$COVERAGE_UNSTAGED" | sed 's/^/    /' >&2
    else
      echo "[pre-commit] Paid-seat coverage: CLEAN"
    fi
  else
    echo "[pre-commit] coverage contract: SCRIPT ABSENT in this checkout — skipped (announced, not silent)"
  fi

  # Cross-table parity (SWA-218 round 5). Same scope, same reason, ~0.15s.
  #
  # The coverage contract asks "is this seat metered at all". This asks "do the two
  # sides AGREE" — and they did not. The gate reserved budget under `claude-fable-5`
  # while the writer settled under `anthropic/claude-fable-5`, so no completed call
  # ever released its hold and every consult double-counted itself for ten minutes.
  # It also caught the gate pricing Sol at HALF the figure the seat's own provider
  # record has carried since 2026-07-17.
  #
  # Neither is visible from inside either file: each reads correct on its own. Only
  # running the two real sides against each other shows it, which is why this is a
  # commit gate and not a code-review habit.
  PARITY="$REPO_ROOT/scripts/lib/spend-settle.test.mjs"
  if [[ -f "$PARITY" ]]; then
    if ! node --test "$PARITY" > /dev/null 2>&1; then
      node --test "$PARITY" 2>&1 | grep -E "^not ok|error:|provider record|never settled" >&2
      echo "COMMIT BLOCKED: the spend gate and the seat writers disagree." >&2
      echo "  A key mismatch means holds never settle; a price mismatch means the cap" >&2
      echo "  is counting the wrong number. Details above." >&2
      exit 1
    fi
    echo "[pre-commit] Seat parity (keys + prices): CLEAN"
  else
    echo "[pre-commit] seat parity: SCRIPT ABSENT in this checkout — skipped (announced, not silent)"
  fi
fi

exit 0
