+) => {
+  const perHundredGrams = firstMacro(info, ['sodium_100g']);
+  if (perHundredGrams !== null) {
+    const servingValue = servingGrams ? perHundredGrams * servingGrams / 100 : perHundredGrams;
+    return roundMacro(servingValue * 1000);
+  }
