# .secretignore — allowlist for scripts/scan-secrets.sh
# Created: 2026-04-19 (3-Brain Pipeline v3 Patch 1)
#
# FORMAT (one entry per line):
#   # comment                                          — ignored
#   docs/path/file.md                                  — allowlist ALL secrets in file (DANGEROUS)
#   docs/path/file.md::pattern-name                    — allowlist ONE pattern in ONE file (SAFE)
#   @pattern-name                                      — allowlist pattern globally (VERY DANGEROUS)
#
# Pattern names (from scan-secrets.sh):
#   anthropic-api-key, openai-project-key, openai-standard-key,
#   google-api-key, slack-bot-token, github-pat, github-fg-pat,
#   aws-access-key, postgres-url, mongodb-url, mysql-url,
#   jwt-token, pem-private-key, ssh-private-key,
#   rotated-render-pg-2026-04, rotated-gemini-2026-04

# ============================================
# Incident documentation — rotated secrets referenced for historical record only
# (Credentials are DEAD. Referenced strings are needed to document what was leaked.)
# ============================================
docs/ai-workflow/AI-HANDOFF/SECURITY-REMEDIATION-2026-04-19.md::rotated-render-pg-2026-04
docs/ai-workflow/AI-HANDOFF/SECURITY-REMEDIATION-2026-04-19.md::rotated-gemini-2026-04
docs/ai-workflow/AI-HANDOFF/3-BRAIN-PIPELINE-PLAN-v2-2026-04-19.md::rotated-gemini-2026-04
docs/ai-workflow/AI-HANDOFF/3-BRAIN-PIPELINE-PLAN-v3-FINAL-2026-04-19.md::rotated-gemini-2026-04
docs/ai-workflow/AI-HANDOFF/3-BRAIN-PIPELINE-CODEX-REVIEW-BRIEFING-2026-04-19.md::rotated-gemini-2026-04
docs/ai-workflow/AI-HANDOFF/3-BRAIN-PIPELINE-V3-PATCHES-2026-04-19.md::rotated-render-pg-2026-04
docs/ai-workflow/AI-HANDOFF/3-BRAIN-PIPELINE-V3-PATCHES-2026-04-19.md::rotated-gemini-2026-04
docs/ai-workflow/AI-HANDOFF/OPUS-CODEX-DEBATE-3-BRAIN-PIPELINE-V3-2026-04-19.md::rotated-render-pg-2026-04
docs/ai-workflow/AI-HANDOFF/OPUS-CODEX-DEBATE-3-BRAIN-PIPELINE-V3-2026-04-19.md::rotated-gemini-2026-04

# The scanner itself contains the fingerprints as literal regex — must allowlist
scripts/scan-secrets.sh::rotated-render-pg-2026-04
scripts/scan-secrets.sh::rotated-gemini-2026-04
scripts/scan-secrets.sh::google-api-key
scripts/scan-secrets.sh::anthropic-api-key
scripts/scan-secrets.sh::openai-project-key
