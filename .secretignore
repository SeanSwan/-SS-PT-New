scripts/scan-secrets.sh::slack-bot-token
scripts/scan-secrets.sh::github-pat
scripts/scan-secrets.sh::github-fg-pat
scripts/scan-secrets.sh::aws-access-key
scripts/scan-secrets.sh::jwt-token
scripts/scan-secrets.sh::postgres-url
