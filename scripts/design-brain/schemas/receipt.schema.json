{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swan-design-brain/receipt/1",
  "title": "Inspection receipt — atomic, agent-written, never adjudicated, spot-checkable",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId", "domainId", "product", "refType", "surface", "platform",
    "hierarchyNotes", "principleCandidates", "inspectorActorId", "openedAtUtc"
  ],
  "properties": {
    "receiptId": { "type": "string", "pattern": "^RCP-[A-Za-z0-9-]{4,}$" },
    "runId": { "type": "string" },
    "domainId": { "type": "string", "description": "coverage domain from config/domains.json, e.g. D01" },
    "product": { "type": "string", "minLength": 2, "description": "shipped product observed, e.g. Hevy" },
    "refType": { "enum": ["screen", "flow", "section"] },
    "surface": { "type": "string", "minLength": 3 },
    "platform": { "enum": ["ios", "android", "web"] },
    "stepCount": { "type": "integer", "minimum": 1, "maximum": 50 },
    "hierarchyNotes": {
      "type": "string", "minLength": 40,
      "description": "substantive observation — the 40-char floor rejects vacuous receipts"
    },
    "stateNotes": { "type": "string", "description": "empty/error/loading/offline states observed" },
    "principleCandidates": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 15 }
    },
    "inspectorActorId": { "type": "string", "minLength": 3 },
    "openedAtUtc": { "type": "string", "format": "date-time" }
  },
  "x-denied-fields": [
    "screenshot", "image", "html", "pageCopy", "cookie", "token", "oauthUrl", "connectorUrl",
    "accountEmail", "customerData"
  ],
  "x-notes": "Deep links stay client-side and are NEVER stored. Verbatim UI copy is capped at 25 chars inside notes by convention (ToS hygiene)."
}
