{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "swan-design-brain/receipt/1",
    "title":  "Inspection receipt â€” atomic, agent-written, never adjudicated, spot-checkable",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "receiptId",
                     "domainId",
                     "product",
                     "refType",
                     "surface",
                     "platform",
                     "hierarchyNotes",
                     "principleCandidates",
                     "inspectorActorId",
                     "openedAtUtc",
                     "sourceClass",
                     "sourceEvidence"
                 ],
    "properties":  {
                       "receiptId":  {
                                         "type":  "string",
                                         "pattern":  "^RCP-[A-Za-z0-9-]{4,}$"
                                     },
                       "runId":  {
                                     "type":  "string"
                                 },
                       "domainId":  {
                                        "type":  "string",
                                        "description":  "coverage domain from config/domains.json, e.g. D01"
                                    },
                       "product":  {
                                       "type":  "string",
                                       "minLength":  2,
                                       "description":  "shipped product observed, e.g. Hevy"
                                   },
                       "refType":  {
                                       "enum":  [
                                                    "screen",
                                                    "flow",
                                                    "section"
                                                ]
                                   },
                       "surface":  {
                                       "type":  "string",
                                       "minLength":  3
                                   },
                       "platform":  {
                                        "enum":  [
                                                     "ios",
                                                     "android",
                                                     "web"
                                                 ]
                                    },
                       "stepCount":  {
                                         "type":  "integer",
                                         "minimum":  1,
                                         "maximum":  50
                                     },
                       "hierarchyNotes":  {
                                              "type":  "string",
                                              "minLength":  40,
                                              "description":  "substantive observation â€” the 40-char floor rejects vacuous receipts"
                                          },
                       "stateNotes":  {
                                          "type":  "string",
                                          "description":  "empty/error/loading/offline states observed"
                                      },
                       "principleCandidates":  {
                                                   "type":  "array",
                                                   "minItems":  1,
                                                   "items":  {
                                                                 "type":  "string",
                                                                 "minLength":  15
                                                             }
                                               },
                       "inspectorActorId":  {
                                                "type":  "string",
                                                "minLength":  3
                                            },
                       "openedAtUtc":  {
                                           "type":  "string",
                                           "format":  "date-time"
                                       },
                       "sourceClass":  {
                                           "enum":  [
                                                        "owned-synthetic",
                                                        "synthetic",
                                                        "licensed",
                                                        "mobbin"
                                                    ],
                                           "description":  "Required classification; production-derived input is forbidden and Mobbin is X-blocked absent signed clearance."
                                       },
                       "sourceEvidence":  {
                                              "type":  "object",
                                              "additionalProperties":  false,
                                              "required":  [
                                                               "schemaVersion",
                                                               "recordId",
                                                               "purpose",
                                                               "approvedBy",
                                                               "notBefore",
                                                               "notAfter",
                                                               "evidenceRefs",
                                                               "sourceClass",
                                                               "signature",
                                                               "receiptDigest"
                                                           ],
                                              "properties":  {
                                                                 "schemaVersion":  {
                                                                                       "const":  "authority/1"
                                                                                   },
                                                                 "recordId":  {
                                                                                  "type":  "string"
                                                                              },
                                                                 "purpose":  {
                                                                                 "const":  "source-classification"
                                                                             },
                                                                 "approvedBy":  {
                                                                                    "const":  "sean"
                                                                                },
                                                                 "notBefore":  {
                                                                                   "type":  "string",
                                                                                   "format":  "date-time"
                                                                               },
                                                                 "notAfter":  {
                                                                                  "type":  "string",
                                                                                  "format":  "date-time"
                                                                              },
                                                                 "evidenceRefs":  {
                                                                                      "type":  "array",
                                                                                      "minItems":  1,
                                                                                      "items":  {
                                                                                                    "type":  "string"
                                                                                                }
                                                                                  },
                                                                 "sourceClass":  {
                                                                                     "enum":  [
                                                                                                  "owned-synthetic",
                                                                                                  "synthetic",
                                                                                                  "licensed"
                                                                                              ]
                                                                                 },
                                                                 "derivationRef":  {
                                                                                       "type":  [
                                                                                                    "string",
                                                                                                    "null"
                                                                                                ]
                                                                                   },
                                                                 "licenseRef":  {
                                                                                    "type":  [
                                                                                                 "string",
                                                                                                 "null"
                                                                                             ]
                                                                                },
                                                                 "signature":  {
                                                                                   "type":  "string"
                                                                               },
                                                                 "receiptDigest":  {
                                                                                       "type":  "string",
                                                                                       "pattern":  "^[a-f0-9]{64}$"
                                                                                   }
                                                             }
                                          }
                   },
    "x-denied-fields":  [
                            "screenshot",
                            "image",
                            "html",
                            "pageCopy",
                            "cookie",
                            "token",
                            "oauthUrl",
                            "connectorUrl",
                            "accountEmail",
                            "customerData"
                        ],
    "x-notes":  "Deep links stay client-side and are never stored. Legacy receipt files remain readable, but new writes require the hardened source classes."
}
