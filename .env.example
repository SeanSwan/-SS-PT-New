# SwanStudios Environment Variables
# Copy this file to .env and adjust as needed

# Node Environment
NODE_ENV=development

# Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=postgres
PG_DB=swanstudios

# Startup database repair
# Production runs repair by default after migrations. Local dev skips it unless explicitly enabled.
STARTUP_DATABASE_REPAIR=false

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# CORS Settings
# Add additional origins if needed, comma-separated

# Email Configuration (for Nodemailer)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=noreply@swanstudios.com

# SendGrid Configuration (optional)
# Leave blank to disable SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@swanstudios.com

# Twilio Configuration (optional)
# Leave blank to disable Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe Configuration (optional)
# Leave blank to disable Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend Stripe Configuration
# Publishable key for frontend (must match secret key account)
VITE_STRIPE_PUBLISHABLE_KEY=

# Frontend realtime Socket.IO origin.
# Local defaults to http://localhost:10000 when blank.
VITE_SOCKET_URL=

# Canonical training-plan rollout flags (fail closed unless explicitly true).
TRAINING_PLAN_PDF_DERIVATIVES=false
VITE_CLIENT_TODAY_TRAINING_MODULE=false
TRAINING_PLAN_SCHEDULE_PROJECTIONS=false
VITE_TRAINING_PLAN_SCHEDULE_PROJECTIONS=false

# Payment Strategy Selection
# Options: 'checkout' (redirect), 'elements' (embedded), 'manual' (offline)
# Default: 'checkout'
PAYMENT_STRATEGY=checkout

# Admin Configuration
ADMIN_EMAILS=admin@swanstudios.com
ADMIN_PHONES=+15551234567
SUPER_ADMIN_EMAILS=
# Private Report Room owner gate. Dedicated values override OWNER_EMAIL fallback.
SUPPORT_OWNER_EMAILS=
SUPPORT_OWNER_USER_IDS=
ADMIN_PROMOTION_CODE=

# Public contact/configuration
VITE_CONTACT_EMAIL=support@sswanstudios.com
VITE_ZELLE_RECIPIENT=
DEFAULT_ZELLE_RECIPIENT=

# Optional local-only dev login helpers. Leave blank in shared config.
VITE_DEV_ADMIN_USERNAME=
VITE_DEV_ADMIN_PASSWORD=
VITE_DEV_TRAINER_USERNAME=
VITE_DEV_TRAINER_PASSWORD=
VITE_DEV_CLIENT_USERNAME=
VITE_DEV_CLIENT_PASSWORD=
VITE_DEV_TEST_USER_PASSWORD=
DEFAULT_VENMO_HANDLE=
DEFAULT_CHECK_PAYEE_NAME=SwanStudios

# Logging
LOG_LEVEL=info

# Legacy MCP Configuration (retired; keep disabled unless deliberately restoring archived historical tooling)
ENABLE_MCP_ROUTES=false
ENABLE_MCP_SERVICES=false
ENABLE_MCP_HEALTH_CHECKS=false
ENABLE_MCP_HEALTH_ALERTS=false

# AI Village HTTP run trigger (cost-incurring; enable only with Sean's explicit approval)
SWAN_ENABLE_AI_VILLAGE_HTTP_RUN=false

# FatSecret Platform API (Restaurant & Food Nutrition — free tier: 5,000 calls/day)
# Sign up at https://platform.fatsecret.com/
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# ===================== VIDEO LIBRARY V2 =====================
# Cloudflare R2 (S3-compatible object storage for hosted videos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=swanstudios-videos
R2_ENDPOINT=

# Workout plan PDFs use the authenticated /api/workout-plans/:id/pdf/content.pdf proxy.
# In production, missing R2 config and R2 upload failures fail closed by default
# to avoid non-durable Render disk writes.
# Set true only if production has a configured persistent disk for SWAN_WORKOUT_PLAN_UPLOAD_ROOT.
SWAN_WORKOUT_PLAN_ALLOW_R2_LOCAL_FALLBACK=false

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Video configuration
VIDEO_SIGNED_URL_TTL_HOURS=4
VIDEO_MAX_UPLOAD_SIZE_MB=2048

# ── Swan Coach destructive-approval lane (REQUIRED as of 2026-09-02) ─────────
# HMAC key for approval envelopes. >=32 chars. The server REFUSES TO BOOT without it:
# a random per-process key silently voids every approval on deploy (the former P0).
OPERATION_SIGNING_KEY=change-me-to-32-plus-random-characters
# Durable approval store, explicit opt-in. Leave unset for single-instance dev.
# Requires REDIS_URL; uses its own logical DB so it never shares the session store.
# APPROVAL_STORE=redis
# APPROVAL_STORE_REDIS_DB=1
