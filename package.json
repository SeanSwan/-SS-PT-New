{
  "name": "swanstudios",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm start",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:full": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "qa:release": "powershell -ExecutionPolicy Bypass -File scripts/qa/release-verification.ps1",
    "qa:release:fast": "powershell -ExecutionPolicy Bypass -File scripts/qa/release-verification.ps1 -Fast",
    "qa:render-payment-preflight": "node scripts/qa/render-payment-preflight.mjs",
    "qa:stripe-testmode-replay": "node scripts/qa/stripe-testmode-replay.mjs",
    "qa:smoke": "node scripts/qa/playwright-smoke.mjs",
    "qa:smoke:prod": "node scripts/qa/playwright-smoke.mjs --prod",
    "qa:mission": "node scripts/qa/playwright-mission.mjs",
    "qa:mission:prod-readonly": "node scripts/qa/playwright-mission.mjs --prod-readonly",
    "qa:mission:prod-live-readonly": "node scripts/qa/playwright-mission.mjs --prod-live-readonly",
    "qa:mission:prod-live-readonly:roles": "node scripts/qa/playwright-mission.mjs --prod-live-readonly --require-prod-auth-roles=admin,trainer,client",
    "qa:dashboard-crawl:prod": "node scripts/qa/playwright-mission.mjs --prod-live-readonly --require-prod-auth-roles=admin,trainer,client,user --grep=@dashboard-crawl -- --project=\"Desktop Chrome\"",
    "qa:prod-auth:capture": "node scripts/qa/capture-prod-auth-state.mjs",
    "qa:prod-auth:capture:admin": "node scripts/qa/capture-prod-auth-state.mjs --role=admin",
    "qa:prod-auth:capture:trainer": "node scripts/qa/capture-prod-auth-state.mjs --role=trainer",
    "qa:prod-auth:capture:client": "node scripts/qa/capture-prod-auth-state.mjs --role=client",
    "qa:prod-auth:capture:user": "node scripts/qa/capture-prod-auth-state.mjs --role=user",
    "qa:prod-auth:bootstrap-dashboard": "node scripts/qa/bootstrap-prod-dashboard-auth.mjs",
    "qa:dashboard-crawl:prod:auto": "node scripts/qa/bootstrap-prod-dashboard-auth.mjs --run-crawl",
    "qa:mission:cleanup": "node scripts/qa/mission-qa-cleanup.mjs",
    "qa:mission:report": "node scripts/qa/mission-report.mjs",
    "code-health": "fallow --format json",
    "code-health:audit": "fallow audit --base HEAD --gate all --format json",
    "code-health:audit:main": "fallow audit --base main --format json",
    "code-health:dead": "fallow dead-code --format json",
    "code-health:dupes": "fallow dupes --format json",
    "code-health:health": "fallow health --format json",
    "code-health:fix-preview": "fallow fix --dry-run --format json",
    "check-docs-links": "npx markdown-link-check docs/**/*.md docs/*.md README.md --config .github/markdown-link-check-config.json",
    "check:main-parity": "node scripts/check-main-parity.mjs",
    "backup": "node scripts/backup-repo.mjs",
    "backup:verify": "node scripts/backup-repo.mjs --verify-only",
    "db:drift-check": "node backend/scripts/schema-drift-check.mjs"
  },
  "devDependencies": {
    "fallow": "^2.88.3",
    "markdown-link-check": "^3.12.1"
  }
}
