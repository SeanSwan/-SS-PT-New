# Render Production Environment Configuration
# ==========================================
# Environment variables for Render deployment to fix infrastructure issues

# Database Configuration
NODE_ENV=production
USE_SQLITE_FALLBACK=false

# Redis Configuration (Disable Redis connections)
REDIS_ENABLED=false
REDIS_HOST=disabled
REDIS_PORT=disabled
REDIS_URL=disabled

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000

# Error Handling
SUPPRESS_REDIS_ERRORS=true
LOG_LEVEL=info

# Performance Settings
NODE_OPTIONS=--max-old-space-size=512

# Static Assets
PUBLIC_URL=https://sswanstudios.com

# Legacy MCP Services (retired; keep disabled)
ENABLE_MCP_ROUTES=false
ENABLE_MCP_SERVICES=false
ENABLE_MCP_HEALTH_CHECKS=false
ENABLE_MCP_HEALTH_ALERTS=false

# Admin/payment defaults
SUPER_ADMIN_EMAILS=
ADMIN_PROMOTION_CODE=
VITE_CONTACT_EMAIL=support@sswanstudios.com
VITE_ZELLE_RECIPIENT=
DEFAULT_ZELLE_RECIPIENT=
DEFAULT_VENMO_HANDLE=
DEFAULT_CHECK_PAYEE_NAME=SwanStudios

# CRITICAL: These environment variables should be set in Render Dashboard:
# - DATABASE_URL (PostgreSQL connection string)
# - VITE_STRIPE_PUBLISHABLE_KEY (canonical publishable key — matches render.yaml)
# - STRIPE_SECRET_KEY
# - STRIPE_WEBHOOK_SECRET
# - JWT_SECRET
# - Other sensitive credentials

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_RETRY_COUNT=3
