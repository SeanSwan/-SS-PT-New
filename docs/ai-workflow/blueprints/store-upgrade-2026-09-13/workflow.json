      "findings": {
        "glm:F1": {
          "id": "F1",
          "priority": "medium",
          "title": "Variant-table availability cache latches false permanently on transient failure",
          "files": [
            "backend/routes/storeFrontRoutes.mjs"
          ],
          "explanation": "cachedVariantTableAvailable is set false on any describeTable error, including a transient startup/connection blip. Variants (prices, stock) then silently vanish from all catalog responses for the process lifetime; a later-healed DB never retries. Failure direction is hide-not-leak, so severity is capped, but it is a silent, unrecoverable degradation.",
          "fix": "Only latch on definitive 'table does not exist' errors (e.g., check error name/table-missing code); for other errors return [] without caching, or add a short TTL/retry window before latching.",
          "status": "open",
          "seat": "glm",
          "findingKey": "glm:F1",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-glm-review.json",
            "sha256": "6fb1e32329e9cac5f7ca5e31450c2745a6a51d82423ee460a1a2c4dba6350fb9"
          }
        },
        "glm:F2": {
          "id": "F2",
          "priority": "low",
          "title": "Display money serialized as unrounded float",
          "files": [
            "backend/services/store/storefrontDisplayService.mjs"
          ],
          "explanation": "resolveDisplayPrice and parsePositiveMoney return Decimal.toNumber() without 2-dp quantization. A stored 3+ dp value (or non-DECIMAL column) would surface as e.g. 12.305 in the public DTO. Charge rails correctly keep Decimal; this is display-only cosmetic risk.",
          "fix": "Quantize at serialization: parsed.toDecimalPlaces(2, Decimal.ROUND_HALF_UP).toNumber() in resolveDisplayPrice (and optionally parsePositiveMoney).",
          "status": "rejected",
          "seat": "glm",
          "findingKey": "glm:F2",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-glm-review.json",
            "sha256": "6fb1e32329e9cac5f7ca5e31450c2745a6a51d82423ee460a1a2c4dba6350fb9"
          },
          "reason": "The hypothesized stored 3+ decimal-place values are outside the inspected currency schema: StorefrontItem price, pricePerSession and totalCost, and ProductVariant price are DECIMAL(10,2). Model-calculated totals also use toFixed(2). The mapper performs no arithmetic before serialization. This is not an established defect for supported persisted inputs; live schema drift remains unverified. Adding display-only rounding without evidence could undermine the deliberate shared resolver contract.",
          "evidence": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-astra-source-evidence.json",
            "sha256": "917c41ef40c3910c2dd88f49106d56719357093c1d7c1fbf275110289bfcac44"
          },
          "adjudicatedBy": "astra"
        },
        "glm:F3": {
          "id": "F3",
          "priority": "low",
          "title": "Monthly priceDetails can interpolate nulls",
          "files": [
            "backend/services/store/storefrontDisplayService.mjs"
          ],
          "explanation": "For packageType 'monthly' with missing months/sessionsPerWeek, priceDetails renders \"null months, undefined sessions/week\". Harmless for money truth, but it is a user-visible string on the public DTO.",
          "fix": "Build priceDetails only when both fields are present; otherwise emit null.",
          "status": "open",
          "seat": "glm",
          "findingKey": "glm:F3",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-glm-review.json",
            "sha256": "6fb1e32329e9cac5f7ca5e31450c2745a6a51d82423ee460a1a2c4dba6350fb9"
          }
        },
        "glmflash:F1": {
          "id": "F1",
          "priority": "LOW",
          "title": "Price-column sorting can contradict canonical display price",
          "files": [
            "backend/routes/storeFrontRoutes.mjs",
            "backend/services/store/storefrontDisplayService.mjs"
          ],
          "explanation": "sortBy is validated against rawAttributes, so ?sortBy=price|totalCost orders by the raw column. After this repair the shown amount is the resolved price (variant -> totalCost -> price, garbage skipped), so list order can visibly disagree with displayed prices (e.g., garbage price column but valid totalCost, or variant-priced physical products).",
          "fix": "When sortBy is a money field, sort the mapped items in JS by resolved displayPrice (before stripping for gated users), or exclude money fields from sortBy and default to displayOrder.",
          "status": "open",
          "seat": "glmflash",
          "findingKey": "glmflash:F1",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-flash-review.json",
            "sha256": "32d72c6fe9f903d84345bfc562e1325a47dc5427c815f57cb7aa946eb35bf263"
          }
        },
        "glmflash:F2": {
          "id": "F2",
          "priority": "LOW",
          "title": "Duplicated description sanitizer risks write/read divergence",
          "files": [
            "backend/routes/storeFrontRoutes.mjs",
            "backend/services/store/storefrontDisplayService.mjs"
          ],
          "explanation": "sanitizeStorefrontDescription exists in both the admin write path and the public display mapping. Two copies will drift; a future change to one (e.g., new entity decoding) silently leaves the other stale.",
          "fix": "Extract to a shared util module and import it in both places.",
          "status": "rejected",
          "seat": "glmflash",
          "findingKey": "glmflash:F2",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-flash-review.json",
            "sha256": "32d72c6fe9f903d84345bfc562e1325a47dc5427c815f57cb7aa946eb35bf263"
          },
          "reason": "The two sanitizers currently have equivalent non-string handling and identical replacement order and patterns. The provider identifies possible future maintenance drift, not present behavioral divergence. Shared extraction is optional cleanup and does not justify a blocking defect.",
          "evidence": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-astra-source-evidence.json",
            "sha256": "917c41ef40c3910c2dd88f49106d56719357093c1d7c1fbf275110289bfcac44"
          },
          "adjudicatedBy": "astra"
        },
        "glmflash:F3": {
          "id": "F3",
          "priority": "LOW",
          "title": "Variant include is latched off permanently after one transient failure",
          "files": [
            "backend/routes/storeFrontRoutes.mjs"
          ],
          "explanation": "cachedVariantTableAvailable=false after a single describeTable failure (e.g., transient DB blip) disables variants for the lifetime of the process, silently degrading the catalog. Acceptable as fail-safe, but unrecoverable without restart.",
          "fix": "Time-box the negative cache (e.g., retry after N minutes) or log at error level with an operator-visible signal instead of a one-time warn.",
          "status": "open",
          "seat": "glmflash",
          "findingKey": "glmflash:F3",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-flash-review.json",
            "sha256": "32d72c6fe9f903d84345bfc562e1325a47dc5427c815f57cb7aa946eb35bf263"
          }
        },
        "astra:ASTRA-F1": {
          "id": "ASTRA-F1",
          "priority": "P2",
          "title": "A transient variant probe failure permanently disables variant inclusion",
          "explanation": "The catch block sets the module-level availability cache to false for every error. Subsequent requests return an empty include without retrying. A recovered connection therefore cannot restore variant prices, options or stock until process restart. This behavior exists in HEAD already, but remains a real unresolved defect. GLM F1 and Flash F3 describe the same issue.",
          "files": [
            "C:/Users/BigotSmasher/Desktop/quick-pt/SS-PT/tmp/worktrees/store-upgrade-20260913/backend/routes/storeFrontRoutes.mjs:126"
          ],
          "status": "open",
          "seat": "astra",
          "findingKey": "astra:ASTRA-F1",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-astra-review.json",
            "sha256": "db309025fcc10775d5be51e1a1c0b302112a5c1b1980004316b73e652d9babfc"
          }
        },
        "astra:ASTRA-F2": {
          "id": "ASTRA-F2",
          "priority": "P3",
          "title": "Nullable monthly fields produce invalid public description text",
          "explanation": "The mapper interpolates months and sessionsPerWeek unconditionally for monthly packages. Both fields permit null in StorefrontItem, and the calculation hook does not require them. A supported monthly record can therefore produce 'null months, null sessions/week'. The baseline has the same defect; extraction has preserved it.",
          "files": [
            "C:/Users/BigotSmasher/Desktop/quick-pt/SS-PT/tmp/worktrees/store-upgrade-20260913/backend/services/store/storefrontDisplayService.mjs:108",
            "C:/Users/BigotSmasher/Desktop/quick-pt/SS-PT/tmp/worktrees/store-upgrade-20260913/backend/models/StorefrontItem.mjs:79"
          ],
          "status": "open",
          "seat": "astra",
          "findingKey": "astra:ASTRA-F2",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-astra-review.json",
            "sha256": "db309025fcc10775d5be51e1a1c0b302112a5c1b1980004316b73e652d9babfc"
          }
        },
        "astra:ASTRA-F3": {
          "id": "ASTRA-F3",
          "priority": "P3",
          "title": "Supported price sorting can contradict the returned price",
          "explanation": "The query sorts and paginates using the raw price column, while the mapper now returns totalCost before price. For example, A(price=100,totalCost=900) and B(price=200,totalCost=400) return in A,B order for price ASC while displaying 900,400. These values fit the model schema. The finding holds without malformed data or variant assumptions. Sorting only the retrieved page in JavaScript would not repair ordering across pages.",
          "files": [
            "C:/Users/BigotSmasher/Desktop/quick-pt/SS-PT/tmp/worktrees/store-upgrade-20260913/backend/routes/storeFrontRoutes.mjs:235",
            "C:/Users/BigotSmasher/Desktop/quick-pt/SS-PT/tmp/worktrees/store-upgrade-20260913/backend/services/store/storefrontDisplayService.mjs:98"
          ],
          "status": "open",
          "seat": "astra",
          "findingKey": "astra:ASTRA-F3",
          "report": {
            "path": ".mega-blueprints/artifacts/44866dbf60f0c9c9/s1-r2-astra-review.json",
            "sha256": "db309025fcc10775d5be51e1a1c0b302112a5c1b1980004316b73e652d9babfc"
          }
        }
