{
  "$id": "panel-ledger-annex-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "roundId",
      "packetSha256",
      "seatArtifactDigests",
      "adjudicationRecordDigest",
      "verdict",
      "annexReceiptHash"
    ],
    "properties": {
      "schemaVersion": { "const": "1.0.0" },
      "roundId": { "type": "string", "pattern": "^r[0-9]+$" },
      "packetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "seatArtifactDigests": {
        "type": "object",
        "additionalProperties": false,
        "required": ["glm", "glmflash", "activeBuilder"],
        "properties": {
          "glm": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "glmflash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "activeBuilder": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      },
      "adjudicationRecordDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
      "verdict": { "enum": ["REVISE", "CLEAN", "VOID", "UNADJUDICATED"] },
      "annexReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  }
}
